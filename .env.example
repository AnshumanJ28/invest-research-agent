# Hugging Face API Token (Required for FinBERT sentiment scoring agent)
# Get a token at: https://huggingface.co/settings/tokens
# If left blank, the pipeline falls back to TextBlob (local rule-based sentiment).
HF_API_TOKEN= 

# NewsAPI Key (Required for news_agent to fetch articles)
# Get a key at: https://newsapi.org/
NEWSAPI_KEY= 

# Gemini API Key (Required for Role 3 memo generation)
# Get a key from Google AI Studio. Do not commit real keys.
GEMINI_API_KEY=

# Optional Gemini model override for Role 3 memo generation.
# Default in code: gemini-3.6-flash
GEMINI_MODEL=gemini-3.6-flash

# Optional output cap for structured memo generation.
GEMINI_MAX_OUTPUT_TOKENS=8192

# Role 3 RAG configuration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_TOP_K=5
ENABLE_VERIFICATION=true
VERIFY_BATCH_SIZE=1
RAG_DB_PATH=cpp_pipeline/invest.sqlite
RAG_OUTPUT_DIR=rag/output

# PostgreSQL DSN / Connection String (For storage.py layer)
# Example format: postgresql://username:password@localhost:5432/database_name
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/investment_db
